+std::optional<WORKSPACEID> mappedWorkspaceID(const std::string& workspace)
+{
+    try {
+        size_t     pos = 0;
+        auto const id = std::stoll(workspace, &pos);
+        if (pos != workspace.size())
+            return std::nullopt; // trailing characters => not a plain ID
+        return static_cast<WORKSPACEID>(id);
+    }
+    catch (const std::exception&) {
+        return std::nullopt;
+    }
+}
+
+PHLWORKSPACE findMappedWorkspace(const std::string& workspace)
+{
+    if (auto const id = mappedWorkspaceID(workspace))
+        return State::workspaceState()->query().id(*id).run();
+    return State::workspaceState()->query().name(workspace).run();
+}
+
+bool isMappedWorkspace(const std::string& mapped, const PHLWORKSPACE& workspace)
+{
+    if (workspace == nullptr)
+        return false;
+    if (auto const id = mappedWorkspaceID(mapped))
+        return workspace->m_id == *id;
+    return workspace->m_name == mapped;
+}
